---
layout: layout.vto
title: Monthly Visits
description: "The number of visits to pharzan.com this month."
bodyClass: me-page analytics-page
---

<header class="analytics-header">
  <h1>Site visits</h1>
  <p>A simple, privacy-friendly count powered by <a href="https://umami.is/" target="_blank" rel="noopener noreferrer">Umami</a>.</p>
</header>

<section class="analytics-card" aria-label="Visit totals">
  <div class="analytics-totals">
    <div class="analytics-stat">
      <p class="analytics-label">Visits this month</p>
      <p class="analytics-value" data-visits aria-live="polite">&mdash;</p>
      <p class="analytics-period" data-period></p>
    </div>
    <div class="analytics-stat">
      <p class="analytics-label">All-time visits</p>
      <p class="analytics-value" data-all-time-visits
        aria-live="polite">&mdash;</p>
      <p class="analytics-period">Since tracking began</p>
    </div>
  </div>
  <p class="analytics-status" data-status>Loading the latest count&hellip;</p>
</section>

<section class="analytics-ranking" aria-labelledby="all-time-ranking-label">
  <header class="analytics-ranking-header">
    <h2 id="all-time-ranking-label">Most visited</h2>
    <p>Pages ranked by visits</p>
  </header>
  <ol class="analytics-ranking-list" data-ranking aria-live="polite">
    <li class="analytics-ranking-loading">Loading the ranking&hellip;</li>
  </ol>
</section>

<noscript>
  <p class="analytics-fallback">
    JavaScript is required to load the count.
    <a href="https://cloud.umami.is/share/uiutvAvdAdCCXdwv" target="_blank" rel="noopener noreferrer">
      Open the public analytics dashboard
    </a>.
  </p>
</noscript>

<script>
(() => {
  const shareUrl =
    "https://cloud.umami.is/analytics/eu/api/share/uiutvAvdAdCCXdwv";
  const apiBase = "https://cloud.umami.is/analytics/eu/api";
  const visitsElement = document.querySelector("[data-visits]");
  const allTimeVisitsElement = document.querySelector("[data-all-time-visits]");
  const periodElement = document.querySelector("[data-period]");
  const statusElement = document.querySelector("[data-status]");
  const rankingElement = document.querySelector("[data-ranking]");

  const now = new Date();
  const startOfMonth = new Date(now.getFullYear(), now.getMonth(), 1);
  periodElement.textContent = new Intl.DateTimeFormat(undefined, {
    month: "long",
    year: "numeric",
  }).format(now);

  async function fetchPublicData(path, token) {
    const response = await fetch(`${apiBase}${path}`, {
      headers: {
        "x-umami-share-token": token,
        "x-umami-share-context": "1",
      },
    });
    if (!response.ok) throw new Error("Unable to load visit statistics");
    return response.json();
  }

  async function loadVisitTotals(token, websiteId) {
    try {
      const monthlyParameters = new URLSearchParams({
        startAt: String(startOfMonth.getTime()),
        endAt: String(now.getTime()),
      });
      const allTimeParameters = new URLSearchParams({
        startAt: "0",
        endAt: String(now.getTime()),
      });
      const [monthlyStats, allTimeStats] = await Promise.all([
        fetchPublicData(
          `/websites/${websiteId}/stats?${monthlyParameters}`,
          token,
        ),
        fetchPublicData(
          `/websites/${websiteId}/stats?${allTimeParameters}`,
          token,
        ),
      ]);
      if (
        !Number.isFinite(monthlyStats.visits) ||
        !Number.isFinite(allTimeStats.visits)
      ) {
        throw new Error("Invalid visit statistics");
      }

      visitsElement.textContent = new Intl.NumberFormat().format(
        monthlyStats.visits,
      );
      allTimeVisitsElement.textContent = new Intl.NumberFormat().format(
        allTimeStats.visits,
      );
      statusElement.textContent = "Updated just now";
    } catch (error) {
      console.error("Could not load visit totals", error);
      visitsElement.textContent = "Unavailable";
      visitsElement.classList.add("analytics-value-error");
      allTimeVisitsElement.textContent = "Unavailable";
      allTimeVisitsElement.classList.add("analytics-value-error");
      statusElement.innerHTML =
        '<a href="https://cloud.umami.is/share/uiutvAvdAdCCXdwv" target="_blank" rel="noopener noreferrer">View the public dashboard</a>';
    }
  }

  function formatPageName(path) {
    if (path === "/") return "Home";

    const slug = path.split("/").filter(Boolean).at(-1) || path;
    const names = {
      me: "Me",
      analytics: "Analytics",
      vscode: "VS Code",
      json: "JSON",
    };

    try {
      return decodeURIComponent(slug)
        .split("-")
        .map((word) =>
          names[word] || word.charAt(0).toUpperCase() + word.slice(1)
        )
        .join(" ");
    } catch {
      return slug;
    }
  }

  function renderRanking(pages) {
    rankingElement.replaceChildren();

    pages.forEach(({ path, visits }, index) => {
      const item = document.createElement("li");
      item.className = "analytics-ranking-item";

      const rank = document.createElement("span");
      rank.className = "analytics-rank";
      rank.textContent = `#${index + 1}`;

      const link = document.createElement("a");
      link.href = path;
      link.textContent = formatPageName(path);
      link.title = path;

      const count = document.createElement("span");
      count.className = "analytics-ranking-count";
      count.textContent = `${new Intl.NumberFormat().format(visits)} ${
        visits === 1 ? "visit" : "visits"
      }`;

      item.append(rank, link, count);
      rankingElement.append(item);
    });
  }

  async function loadAllTimeRanking(token, websiteId) {
    try {
      const parameters = new URLSearchParams({
        startAt: "0",
        endAt: String(now.getTime()),
        type: "path",
        limit: "500",
      });
      const metrics = await fetchPublicData(
        `/websites/${websiteId}/metrics/expanded?${parameters}`,
        token,
      );

      const totals = new Map();
      metrics.forEach(({ name, visits }) => {
        if (typeof name !== "string" || !Number.isFinite(visits)) return;
        const normalizedPath = name.startsWith("/") ? name : `/${name}`;
        const path = normalizedPath.replace(/\/+$/, "") || "/";
        totals.set(path, (totals.get(path) || 0) + visits);
      });

      const pages = Array.from(totals, ([path, visits]) => ({ path, visits }))
        .sort((a, b) => b.visits - a.visits)
        .slice(0, 10);
      renderRanking(pages);
    } catch (error) {
      console.error("Could not load all-time ranking", error);
      rankingElement.innerHTML =
        '<li class="analytics-ranking-loading">Ranking unavailable. <a href="https://cloud.umami.is/share/uiutvAvdAdCCXdwv" target="_blank" rel="noopener noreferrer">View the public dashboard</a>.</li>';
    }
  }

  async function loadAnalytics() {
    try {
      const shareResponse = await fetch(shareUrl);
      if (!shareResponse.ok) throw new Error("Unable to load the public share");

      const { token, websiteId } = await shareResponse.json();
      if (!token || !websiteId) {
        throw new Error("Invalid public share response");
      }

      await Promise.all([
        loadVisitTotals(token, websiteId),
        loadAllTimeRanking(token, websiteId),
      ]);
    } catch (error) {
      console.error("Could not load public analytics", error);
      visitsElement.textContent = "Unavailable";
      visitsElement.classList.add("analytics-value-error");
      allTimeVisitsElement.textContent = "Unavailable";
      allTimeVisitsElement.classList.add("analytics-value-error");
      statusElement.textContent = "Visit count unavailable";
      rankingElement.innerHTML =
        '<li class="analytics-ranking-loading">Ranking unavailable. <a href="https://cloud.umami.is/share/uiutvAvdAdCCXdwv" target="_blank" rel="noopener noreferrer">View the public dashboard</a>.</li>';
    }
  }

  loadAnalytics();
})();
</script>
