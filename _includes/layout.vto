<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{{ title }}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {{ if description }}
    <meta name="description" content="{{ description }}" />
    {{ /if }}
    <meta property="og:type" content="website" />
    <meta property="og:title" content="{{ title ? title + ' · Farzan Tinati' : 'Farzan Tinati' }}" />
    <meta property="og:description" content="{{ description }}" />
    <meta property="og:url" content="{{ page.url | url }}" />
    <link rel="preconnect" href="https://cloud.umami.is" crossorigin />
    <link rel="stylesheet" href="/assets/styles/styles.css" inline />
    <script defer src="https://cloud.umami.is/script.js" data-website-id="aaa4c2de-92e2-4e06-b111-ad366699c4a9"></script>
  </head>
  <body class="{{ bodyClass }}">
    <main>
      <nav class="site-nav" aria-label="Primary">
        <a href="/">Home</a>
        <a href="/me">Me</a>
      </nav>

      {{ content }}

      {{ if url.startsWith("/posts/") && url !== "/posts/" }}
        <hr />
        <section>
          <aside aria-label="About Farzan">
            <p>
              Hey, I’m <a href='/me'>Farzan</a> — I build full-stack products and share hands-on notes on 
                    <span>product development</span>, 
                    <span>tech</span> and 
                    <span>creative-growth</span>.
            </p>
          </aside>

          <h2>Below are some of my recent notes:</h2>
          <nav class="related-posts-list" aria-label="Related posts">
            {{ set count = 0 }}
            {{ for post of search.pages("url^=/posts/", "date=desc") }}
              {{ if post.url !== url && count < 3 }}
                <article class="related-post-item">
                  <h3 class="related-post-title">
                    <a href="{{ post.url }}">{{ post.title }}</a>
                  </h3>
                  {{ if post.date }}
                    <time class="related-post-date">{{ post.date |> date("yyyy-MM-dd") }}</time>
                  {{ /if }}
                </article>
                {{ set count = count + 1 }}
              {{ /if }}
            {{ /for }}
          </nav>
        </section>
      {{ /if }}
    </main>
  </body>
</html>