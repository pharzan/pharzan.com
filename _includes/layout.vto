<!DOCTYPE html>
<html lang="{{ lang || 'en' }}" dir="ltr">
  <head>
    {{ set pageTitle = title + (!title.includes('Farzan Tinati') ? ' | Farzan Tinati' : '') }}
    {{ set isPost = url.startsWith('/posts/') && url !== '/posts/' }}
    {{ set socialImage = image || '/assets/avatar-pixel.png' }}
    {{ set socialImageAlt = imageAlt || 'Farzan Tinati' }}
    <meta charset="UTF-8" />
    <title>{{ pageTitle }}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="{{ description }}" />
    {{ if url === '/analytics/' }}
      <meta name="robots" content="noindex, follow" />
    {{ /if }}
    <link rel="icon" href="/assets/favicon.ico" />
    <link rel="icon" type="image/png" href="/assets/favicon.png" />
    <link rel="alternate" type="application/rss+xml"
      title="Farzan Tinati RSS feed" href="/feed.xml" />
    <link rel="canonical" href="https://pharzan.com{{ url }}" />
    {{ if url.startsWith("/posts/") && url !== "/posts/" }}
      {{ set originalPostUrl = translationOf || url }}
      {{ set alternateLanguages = originalPostUrl |> postTranslations }}
      {{ for language of alternateLanguages }}
        <link rel="alternate" hreflang="{{ language.code }}"
          href="https://pharzan.com{{ language.url }}" />
      {{ /for }}
      <link rel="alternate" hreflang="x-default"
        href="https://pharzan.com{{ originalPostUrl }}" />
    {{ /if }}
    <meta property="og:type" content="{{ isPost ? 'article' : 'website' }}" />
    <meta property="og:site_name" content="Farzan Tinati" />
    <meta property="og:locale" content="{{ (lang || 'en').replace('-', '_') }}" />
    <meta property="og:title" content="{{ pageTitle }}" />
    <meta property="og:description" content="{{ description }}" />
    <meta property="og:url" content="https://pharzan.com{{ url }}" />
    <meta property="og:image" content="https://pharzan.com{{ socialImage }}" />
    <meta property="og:image:alt" content="{{ socialImageAlt }}" />
    {{ if isPost && date }}
      <meta property="article:published_time" content="{{ date.toISOString() }}" />
      <meta property="article:author" content="https://pharzan.com/me/" />
      {{ for tag of tags || [] }}
        <meta property="article:tag" content="{{ tag }}" />
      {{ /for }}
    {{ /if }}
    <meta name="twitter:card" content="{{ image ? 'summary_large_image' : 'summary' }}" />
    <meta name="twitter:title" content="{{ pageTitle }}" />
    <meta name="twitter:description" content="{{ description }}" />
    <meta name="twitter:image" content="https://pharzan.com{{ socialImage }}" />
    <meta name="twitter:image:alt" content="{{ socialImageAlt }}" />
    {{ set jsonLd = url |> structuredData(title, description, date, lang || 'en', tags, image) }}
    {{ if jsonLd }}
      <script type="application/ld+json">{{ jsonLd }}</script>
    {{ /if }}
    <link rel="preconnect" href="https://cloud.umami.is" crossorigin />
    <link rel="stylesheet" href="/assets/styles/styles.css" inline />
    <script defer src="https://cloud.umami.is/script.js"
      data-website-id="aaa4c2de-92e2-4e06-b111-ad366699c4a9"></script>
  </head>
  <body class="{{ bodyClass }}" lang="en" dir="ltr">
    <main>
      <nav class="site-nav" aria-label="Primary">
        <a href="/">Home</a>
        <a href="/me">Me</a>
        <a href="/analytics/">Analytics</a>
      </nav>

      {{ if url.startsWith("/posts/") && url !== "/posts/" }}
        {{ set audioUrl = url |> postAudio }}
        {{ set languages = originalPostUrl |> postTranslations }}
        <aside class="post-meta" aria-label="Post details">
          <span>By <a rel="author" href="/me/">Farzan Tinati</a></span>
          {{ if date }}
            <span>
              Published
              <time datetime="{{ date |> date('yyyy-MM-dd') }}">{{ date |> date("MMMM d, yyyy") }}</time>
            </span>
          {{ /if }}
          <span>{{ content |> readingTime }} min read</span>
          {{ if tags }}
            <span class="post-meta-tags" aria-label="Tags">
              {{ for tag of tags }}
                <span class="tag">{{ tag }}</span>
              {{ /for }}
            </span>
          {{ /if }}
        </aside>

        {{ if languages.length > 1 }}
          <nav class="language-switcher" aria-label="Article language">
            <span class="language-switcher-icon" aria-hidden="true">🌐</span>
            {{ for language of languages }}
              <a
                href="{{ language.url }}"
                lang="{{ language.code }}"
                hreflang="{{ language.code }}"
                title="Read in {{ language.label }}"
                aria-label="Read in {{ language.label }}"
                {{ if language.code === (lang || 'en') }}aria-current="page"{{ /if }}
              >{{ language.code.toUpperCase() }}</a>
            {{ /for }}
          </nav>
        {{ /if }}

        {{ if audioUrl }}
          <section class="audio-player" data-audio-player aria-label="Audio version of this article">
            <audio controls preload="metadata" src="{{ audioUrl }}" data-audio>
              Your browser does not support embedded audio.
            </audio>
            <div class="audio-player-controls" data-audio-controls hidden>
              <button type="button" class="audio-player-toggle" data-audio-toggle aria-label="Play audio version of this article">
                <span aria-hidden="true" data-audio-icon>▶</span>
                <span data-audio-label>Listen</span>
              </button>
              <span class="audio-player-time">
                <span data-audio-current>0:00</span>
                <span aria-hidden="true"> / </span>
                <span data-audio-duration>--:--</span>
              </span>
              <label class="audio-player-speed-label">
                <span class="visually-hidden">Playback speed</span>
                <select class="audio-player-speed" data-audio-speed aria-label="Playback speed">
                  <option value="0.75">0.75×</option>
                  <option value="1" selected>1×</option>
                  <option value="1.25">1.25×</option>
                  <option value="1.5">1.5×</option>
                  <option value="2">2×</option>
                </select>
              </label>
              <input
                class="audio-player-progress"
                data-audio-progress
                type="range"
                min="0"
                max="100"
                step="0.1"
                value="0"
                aria-label="Audio progress"
              />
            </div>
          </section>
          <script defer src="/assets/scripts/audio-player.js"></script>
        {{ /if }}
      {{ /if }}

      {{ if isPost }}
        <article class="post-content" lang="{{ lang || 'en' }}" dir="{{ lang |> textDirection }}">
          {{ content }}
        </article>
      {{ else }}
        {{ content }}
      {{ /if }}

      {{ if url.startsWith("/posts/") && url !== "/posts/" }}
        <hr />
        <section>
          <aside aria-label="About Farzan">
            <p>
              Hey, I’m <a href='/me'>Farzan</a> — I build full-stack products and share hands-on notes on 
                    <span>product development</span>, 
                    <span>tech</span> and 
                    <span>creative-growth</span>.
            </p>
          </aside>

          <h2>Below are some of my recent notes:</h2>
          <nav class="related-posts-list" aria-label="Related posts">
            {{ set count = 0 }}
            {{ for post of search.pages("url^=/posts/ translationOf=undefined", "date=desc") }}
              {{ if post.url !== url && post.url !== translationOf && count < 5 }}
                <article class="related-post-item">
                  <h3 class="related-post-title">
                    <a href="{{ post.url }}">{{ post.title }}</a>
                  </h3>
                  {{ if post.date }}
                    <time class="related-post-date">{{ post.date |> date("yyyy-MM-dd") }}</time>
                  {{ /if }}
                </article>
                {{ set count = count + 1 }}
              {{ /if }}
            {{ /for }}
          </nav>
        </section>

        <section class="comments" aria-labelledby="comments-title">
          <h2 id="comments-title">Comments</h2>
          <p class="comments-note">
            Comments are powered by <a href="https://giscus.app" target="_blank" rel="noopener noreferrer">Giscus</a>
            and require a GitHub account.
          </p>
          <script
            src="https://giscus.app/client.js"
            data-repo="pharzan/pharzan.com"
            data-repo-id="R_kgDOPzsHGA"
            data-category="Blog comments"
            data-category-id="DIC_kwDOPzsHGM4DDWDi"
            data-mapping="pathname"
            data-strict="1"
            data-reactions-enabled="1"
            data-emit-metadata="0"
            data-input-position="top"
            data-theme="https://pharzan.com/assets/styles/giscus.css"
            data-lang="en"
            data-loading="lazy"
            crossorigin="anonymous"
            async
          ></script>
        </section>
      {{ /if }}
    </main>
  </body>
</html>
