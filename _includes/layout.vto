<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{{ title }}{{ if !title.includes('Farzan Tinati') }} | Farzan Tinati{{ /if }}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="{{ description }}" />
    <link rel="icon" href="/assets/favicon.ico" />
    <link rel="icon" type="image/png" href="/assets/favicon.png" />
    <link rel="canonical" href="https://pharzan.com{{ url }}" />
    <meta property="og:title"
      content="{{ title }}{{ if !title.includes('Farzan Tinati') }} | Farzan Tinati{{ /if }}" />
    <meta property="og:description" content="{{ description }}" />
    <link rel="preconnect" href="https://cloud.umami.is" crossorigin />
    <link rel="stylesheet" href="/assets/styles/styles.css" inline />
    <script defer src="https://cloud.umami.is/script.js"
      data-website-id="aaa4c2de-92e2-4e06-b111-ad366699c4a9"></script>
  </head>
  <body class="{{ bodyClass }}">
    <main>
      <nav class="site-nav" aria-label="Primary">
        <a href="/">Home</a>
        <a href="/me">Me</a>
        <a href="/analytics/">Analytics</a>
      </nav>

      {{ content }}

      {{ if url.startsWith("/posts/") && url !== "/posts/" }}
        <hr />
        <section>
          <aside aria-label="About Farzan">
            <p>
              Hey, I’m <a href='/me'>Farzan</a> — I build full-stack products and share hands-on notes on 
                    <span>product development</span>, 
                    <span>tech</span> and 
                    <span>creative-growth</span>.
            </p>
          </aside>

          <h2>Below are some of my recent notes:</h2>
          <nav class="related-posts-list" aria-label="Related posts">
            {{ set count = 0 }}
            {{ for post of search.pages("url^=/posts/", "date=desc") }}
              {{ if post.url !== url && count < 5 }}
                <article class="related-post-item">
                  <h3 class="related-post-title">
                    <a href="{{ post.url }}">{{ post.title }}</a>
                  </h3>
                  {{ if post.date }}
                    <time class="related-post-date">{{ post.date |> date("yyyy-MM-dd") }}</time>
                  {{ /if }}
                </article>
                {{ set count = count + 1 }}
              {{ /if }}
            {{ /for }}
          </nav>
        </section>

        <section class="comments" aria-labelledby="comments-title">
          <h2 id="comments-title">Comments</h2>
          <p class="comments-note">
            Comments are powered by <a href="https://giscus.app" target="_blank" rel="noopener noreferrer">Giscus</a>
            and require a GitHub account.
          </p>
          <script
            src="https://giscus.app/client.js"
            data-repo="pharzan/pharzan.com"
            data-repo-id="R_kgDOPzsHGA"
            data-category="Blog comments"
            data-category-id="DIC_kwDOPzsHGM4DDWDi"
            data-mapping="pathname"
            data-strict="1"
            data-reactions-enabled="1"
            data-emit-metadata="0"
            data-input-position="top"
            data-theme="https://pharzan.com/assets/styles/giscus.css"
            data-lang="en"
            data-loading="lazy"
            crossorigin="anonymous"
            async
          ></script>
        </section>
      {{ /if }}
    </main>
  </body>
</html>
