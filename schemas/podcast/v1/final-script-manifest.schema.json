{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated from scripts/podcast/schemas. Do not edit this JSON file directly.",
  "$id": "final-script-manifest.schema.json",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "episode",
    "script_sha256",
    "source_sha256",
    "template",
    "locale",
    "approved_at",
    "pass_attempt",
    "review_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "number"
    },
    "episode": {
      "type": "string"
    },
    "script_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "template": {
      "type": "string"
    },
    "locale": {
      "type": "string"
    },
    "approved_at": {
      "type": "string"
    },
    "pass_attempt": {
      "minimum": 1,
      "type": "integer"
    },
    "review_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    }
  }
}
