{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated from scripts/podcast/schemas. Do not edit this JSON file directly.",
  "$id": "source-map.schema.json",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "source_sha256",
    "blocks"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "number"
    },
    "source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "blocks": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "sha256",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    }
  }
}
