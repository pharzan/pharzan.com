{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated from scripts/podcast/schemas. Do not edit this JSON file directly.",
  "$id": "scene-candidate.schema.json",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "scene_id",
    "request_sha256",
    "audio_sha256",
    "duration_seconds",
    "generated_at",
    "approved"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "number"
    },
    "id": {
      "type": "string"
    },
    "scene_id": {
      "type": "string"
    },
    "request_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "audio_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "duration_seconds": {
      "exclusiveMinimum": 0,
      "type": "number"
    },
    "generated_at": {
      "type": "string"
    },
    "response_id": {
      "type": "string"
    },
    "model_version": {
      "type": "string"
    },
    "mime_type": {
      "type": "string"
    },
    "usage": {},
    "approved": {
      "type": "boolean"
    },
    "approved_at": {
      "type": "string"
    }
  }
}
